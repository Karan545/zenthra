# ─────────────────────────────────────────────────────────────
# ZenthraCurator deploy env (Arc Testnet)
# Copy to .env and fill PRIVATE_KEY when YOU are ready to deploy.
# NEVER commit .env or share your private key.
# ─────────────────────────────────────────────────────────────

# Required only when broadcasting a real deploy
PRIVATE_KEY=

# Arc Testnet RPC (default also baked into scripts)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Optional overrides (defaults are Arc Testnet official addresses)
# IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# USDC=0x3600000000000000000000000000000000000000
# LIST_STAKE_AMOUNT=1000000
# OWNER=
